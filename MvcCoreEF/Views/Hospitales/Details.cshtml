@model Hospital

<h1 class="font-monospace">Hospital Details</h1>

<a asp-action="Index" asp-controller="Hospitales">
	Back To List
</a>

<ul class="list-group">
	<li class="list-group-item active">@Model.IdHospital</li>
	<li class="list-group-item">@Model.Nombre</li>
	<li class="list-group-item">@Model.Direccion</li>
	<li class="list-group-item">@Model.Telefono</li>
	<li class="list-group-item">@Model.Camas</li>
</ul>